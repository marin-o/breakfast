<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 (API 30) and earlier, where one rule set covers both cloud backup and device-to-device transfer. The diary
  (breakfast.db and its journal files) is left out of both; Settings > Export diary is the backup and the way to move
  it. Settings (SharedPreferences) are still backed up.
-->
<full-backup-content>
    <exclude domain="database" path="breakfast.db" />
    <exclude domain="database" path="breakfast.db-wal" />
    <exclude domain="database" path="breakfast.db-shm" />
    <exclude domain="database" path="breakfast.db-journal" />
</full-backup-content>
