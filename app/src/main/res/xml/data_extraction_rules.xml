<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 (API 31) and later. The diary (breakfast.db and its journal files) stays out of Google cloud backup:
  all data stays on the device, and Settings > Export diary is the backup. A device-to-device transfer (a cable or
  local transfer to a new phone) moves everything, the diary included, except the remembered Open Food Facts login
  (off_login.xml), which stays out of both: its key cannot leave this phone. The profile (profile.xml: name, targets, weights) stays out of cloud backup too. Settings
  (settings.xml) stay in cloud backup: they hold no diary data.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="breakfast.db" />
        <exclude domain="database" path="breakfast.db-wal" />
        <exclude domain="database" path="breakfast.db-shm" />
        <exclude domain="database" path="breakfast.db-journal" />
        <exclude domain="sharedpref" path="profile.xml" />
        <exclude domain="sharedpref" path="off_login.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="off_login.xml" />
    </device-transfer>
</data-extraction-rules>
